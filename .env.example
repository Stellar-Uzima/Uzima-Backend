# Signed webhook intake and retry policy
STELLAR_WEBHOOK_SECRET=
WEBHOOK_MAX_ATTEMPTS=5

# Retention policy
STATUS_LOG_RETENTION_DAYS=90

# Referral rewards are held for admin review when either risk signal fires.
REFERRAL_RISK_REVIEW_WINDOW_MS=3600000
REFERRAL_RISK_MAX_REFERRALS_PER_WINDOW=5
# Set above zero to flag referrals redeemed before a referred account reaches this age.
REFERRAL_RISK_MIN_ACCOUNT_AGE_MS=0
# Application
NODE_ENV=development
APP_NAME=Stellar Uzima Backend
APP_PORT=3001
APP_VERSION=1.0.0

# Database
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=stellar_uzima_dev
DB_SYNCHRONIZE=true
DB_LOGGING=true

# Redis
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# Queue
QUEUE_REDIS_HOST=localhost
QUEUE_REDIS_PORT=6379
QUEUE_REDIS_PASSWORD=
QUEUE_REDIS_DB=1
QUEUE_DEFAULT_ATTEMPTS=3
QUEUE_DEFAULT_BACKOFF_DELAY=1000

# Cache
CACHE_DEFAULT_TTL=3600
CACHE_DURATION=300000
CACHE_MAX_RETRIES=3
CACHE_RETRY_DELAY=1000

# JWT
JWT_SECRET=your_jwt_secret_key_here_min_32_chars
JWT_EXPIRATION=3600
JWT_REFRESH_SECRET=your_refresh_secret_key_here_min_32_chars
JWT_REFRESH_EXPIRATION=604800
# --- Token hardening (issue #1287) ---
# `iss` / `aud` are asserted on every token. Change the audience per
# environment so a staging token cannot be replayed against production.
JWT_ISSUER=stellar-uzima
JWT_AUDIENCE=stellar-uzima-api
# Refresh tokens are accepted for a separate audience by default, so a refresh
# token can never be presented as an access token.
JWT_REFRESH_AUDIENCE=stellar-uzima-api
# Token lifetimes in seconds. Access tokens are deliberately short-lived.
JWT_ACCESS_TOKEN_TTL=900
JWT_REFRESH_TOKEN_TTL=604800
# Allowed clock drift, in seconds, when validating exp/nbf.
JWT_CLOCK_TOLERANCE=5
# Days an authentication audit event is retained before purgeExpired() removes it.
AUTH_EVENT_RETENTION_DAYS=180

# Password validation (registration, reset, and change-password flows)
PASSWORD_MIN_LENGTH=8
PASSWORD_MAX_LENGTH=32
PASSWORD_REQUIRE_UPPERCASE=true
PASSWORD_REQUIRE_LOWERCASE=true
PASSWORD_REQUIRE_NUMBERS=true
PASSWORD_REQUIRE_SPECIAL_CHARS=true

# Stellar Blockchain
# STELLAR_NETWORK: "testnet" or "public" ("mainnet" is accepted as an alias of "public").
STELLAR_NETWORK=testnet
STELLAR_HORIZON_URL=https://horizon-testnet.stellar.org
# Optional public keys (G... addresses) for diagnostics; validated at startup when set.
STELLAR_TREASURY_PUBLIC_KEY=
STELLAR_FUNDING_PUBLIC_KEY=
# Signing material is loaded only through ConfigService and never logged.
# STELLAR_TREASURY_SECRET_KEY is required only when STELLAR_SIGNING_ENABLED=true;
# on STELLAR_NETWORK=public, placeholder values abort startup.
STELLAR_SIGNING_ENABLED=false
STELLAR_TREASURY_SECRET_KEY=
STELLAR_FUNDING_SECRET_KEY=
STELLAR_FUNDING_SECRET=your_stellar_account_secret_key

# CORS (comma-separated list of allowed origins)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
# Legacy single-origin fallback (used when CORS_ORIGINS is unset)
CORS_ORIGIN=http://localhost:3000

# Database performance
SLOW_QUERY_THRESHOLD_MS=1000
SLOW_REQUEST_THRESHOLD_MS=5000
# Required only when the encrypted secrets vault is enabled; use a unique 32+ character value.
SECRETS_VAULT_KEY=

# Logging
LOG_LEVEL=debug

# External Services
EMAIL_SERVICE_API_KEY=your_email_service_key
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+15005550006

# Notification provider circuit breaker
NOTIFICATION_CIRCUIT_FAILURE_THRESHOLD=5
NOTIFICATION_CIRCUIT_RESET_MS=30000

# Notification retry policy
NOTIFICATION_RETRY_MAX_ATTEMPTS=3
NOTIFICATION_RETRY_BASE_DELAY_MS=1000
NOTIFICATION_RETRY_TERMINAL_FAILURE_STRATEGY=escalate

# .env.example snippet
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET_NAME=
AWS_S3_ENDPOINT=SLOW_QUERY_THRESHOLD_MS=1000
